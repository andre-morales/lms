			<span class="file-box"></span>
		</div>
	</td>
</table>
<%

function genFileTableEntries(){
	for (var i = 0; i < Files.length; i++){
		var pathName = Files[i];
		var iconPath = getIconImageFor(pathName, thumbnailsEnabled);

		if(pathName.endsWith('/')){
			var folderName = pathName.slice(0, -1);
			var pathURIName = encodeURI(folderName);
			genFileTableEntry(folderName, pathURIName + "/", iconPath);
		} else {	
			var pathURIName = encodeURI(pathName);
			genFileTableEntry(pathName, pathURIName, iconPath);
		}
	}
}

function genFileTableEntry(name, path, image){
	%>
		<span class="file-box file" data-path="<%-path%>">
			<span class="menu-wrapper">
				<button></button>
			</span>
			<a href="<%-path%>" class="file-img"><img src="<%-image%>" width="64"></a>
			<a href="<%-path%>" class="file-name"><%-name%></a>
		</span>
	<%
}
%>