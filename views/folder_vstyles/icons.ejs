<table>
	<td>
		<div id="sbs-view">
			<% genFileTableEntries(); %>
			<span class="file-box"></span>
			<span class="file-box"></span>
			<span class="file-box"></span>
			<span class="file-box"></span>
			<span class="file-box"></span>
